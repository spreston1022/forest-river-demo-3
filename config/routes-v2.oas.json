{
  "openapi": "3.1.0",
  "info": {
    "title": "Forest River API (v2)",
    "version": "2.0.0",
    "description": "Current version of the Forest River API.\n\n**Breaking changes from v1:**\n- `dealerCode` replaced by `dealerId` (UUID) \u2014 aligns with new dealer management system\n- New required `category` field: Camping, Work & Play, Marine, or Specialty\n\nIf you are still on v1, please migrate before **July 1, 2026**."
  },
  "paths": {
    "/v2/vehicles": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "List vehicles",
        "description": "Returns Forest River vehicle inventory. This is the current supported version.",
        "operationId": "v2-get-vehicles",
        "tags": [
          "Vehicles"
        ],
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://echo.zuplo.io"
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound",
              "plan-rate-limit-inbound",
              "mock-api-inbound"
            ]
          }
        },
        "responses": {
          "200": {
            "description": "Vehicle list (v2 schema)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "make": {
                        "type": "string"
                      },
                      "model": {
                        "type": "string"
                      },
                      "year": {
                        "type": "integer"
                      },
                      "type": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string",
                        "enum": [
                          "Camping",
                          "Work & Play",
                          "Marine",
                          "Specialty"
                        ],
                        "description": "New in v2 \u2014 Forest River product category."
                      },
                      "msrp": {
                        "type": "number"
                      },
                      "dealerId": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Replaces `dealerCode` from v1. Now a UUID aligned with the new dealer management system."
                      },
                      "available": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "examples": {
                  "vehicle-list": {
                    "summary": "Sample v2 vehicle inventory",
                    "value": [
                      {
                        "id": "veh-001",
                        "make": "Forest River",
                        "model": "Rockwood Ultra Lite 2892RB",
                        "year": 2025,
                        "type": "travel-trailer",
                        "category": "Camping",
                        "msrp": 42999,
                        "dealerId": "d8f3a2b1-4c5e-4f6a-8b9c-1d2e3f4a5b6c",
                        "available": true
                      },
                      {
                        "id": "veh-002",
                        "make": "Forest River",
                        "model": "Cherokee Wolf Pack 365SUITE16",
                        "year": 2025,
                        "type": "fifth-wheel",
                        "category": "Camping",
                        "msrp": 89995,
                        "dealerId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                        "available": true
                      },
                      {
                        "id": "veh-003",
                        "make": "Forest River",
                        "model": "Work and Play 25WP",
                        "year": 2024,
                        "type": "toy-hauler",
                        "category": "Work & Play",
                        "msrp": 38500,
                        "dealerId": "f9e8d7c6-b5a4-3210-fedc-ba9876543210",
                        "available": false
                      },
                      {
                        "id": "veh-004",
                        "make": "Forest River",
                        "model": "Berkshire XLT 45A",
                        "year": 2025,
                        "type": "class-a-motorhome",
                        "category": "Camping",
                        "msrp": 289995,
                        "dealerId": "c3d4e5f6-a7b8-9012-cdef-012345678901",
                        "available": true
                      },
                      {
                        "id": "veh-005",
                        "make": "Forest River",
                        "model": "Tidewater 232CC",
                        "year": 2025,
                        "type": "center-console-boat",
                        "category": "Marine",
                        "msrp": 54900,
                        "dealerId": "e5f6a7b8-c9d0-1234-efab-234567890123",
                        "available": true
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  }
}