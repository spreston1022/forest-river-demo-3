{
  "openapi": "3.1.0",
  "info": {
    "title": "Forest River API (v2)",
    "version": "2.0.0",
    "description": "Current version of the Forest River Dealer API.\n\n**Breaking changes from v1:**\n- `dealerCode` replaced by `dealerId` (UUID) — aligns with new dealer management system\n- New `category` field on vehicles: Camping, Work & Play, Marine, or Specialty\n\nIf you are still on v1, please migrate before **May 30, 2026**."
  },
  "paths": {
    "/v2/vehicles": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "List vehicles",
        "description": "Returns the Forest River product catalog. Filter by `category` or `type` to narrow results.",
        "operationId": "v2-list-vehicles",
        "tags": [
          "Vehicles"
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Camping",
                "Work & Play",
                "Marine",
                "Specialty"
              ]
            },
            "description": "Filter by product category"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by vehicle type (e.g. travel-trailer, fifth-wheel)"
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by model year"
          }
        ],
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://echo.zuplo.io"
            }
          },
          "policies": {
            "inbound": [
              "kill-switch-vehicles",
              "api-key-inbound",
              "revocation-check-inbound",
              "plan-rate-limit-inbound",
              "mock-api-inbound"
