{
  "policies": [
    {
      "name": "api-key-inbound",
      "policyType": "api-key-inbound",
      "handler": {
        "export": "ApiKeyInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allowUnauthenticatedRequests": false,
          "bucketName": "$env(BUCKET_NAME)"
        }
      }
    },
    {
      "name": "jwt-auth-inbound",
      "policyType": "auth0-jwt-auth-inbound",
      "handler": {
        "export": "Auth0JwtInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "auth0Domain": "dev-l3ayzqncrfw3ta50.us.auth0.com",
          "audience": "https://forest-river-demo",
          "allowUnauthenticatedRequests": false
        }
      }
    },
    {
      "name": "admin-auth-inbound",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/admin-auth)"
      }
    },
    {
      "name": "kill-switch-vehicles",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/maintenance)",
        "options": { "routeKey": "vehicles" }
      }
    },
    {
      "name": "kill-switch-inventory",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/maintenance)",
        "options": { "routeKey": "inventory" }
      }
    },
    {
      "name": "kill-switch-orders",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/maintenance)",
        "options": { "routeKey": "orders" }
      }
    },
    {
      "name": "kill-switch-pricing",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/maintenance)",
        "options": { "routeKey": "pricing" }
      }
    },
    {
      "name": "kill-switch-dealers",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/maintenance)",
        "options": { "routeKey": "dealers" }
      }
    },
    {
      "name": "kill-switch-mcp",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/maintenance)",
        "options": { "routeKey": "mcp" }
      }
    },
    {
      "name": "revocation-check-inbound",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/revocation-check)"
      }
    },
    {
      "name": "plan-rate-limit-inbound",
      "policyType": "rate-limit-inbound",
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "function",
          "requestsAllowed": 100,
          "timeWindowMinutes": 1,
          "identifier": {
            "export": "rateLimit",
            "module": "$import(./modules/rate-limit)"
          }
        }
      }
    },
    {
      "name": "mock-api-inbound",
      "policyType": "mock-api-inbound",
      "handler": {
        "export": "MockApiInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "contentType": "application/json",
          "random": false
        }
      }
    },
    {
      "name": "v1-deprecation-outbound",
      "policyType": "http-deprecation-outbound",
      "handler": {
        "export": "HttpDeprecationOutboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "deprecation": "2026-01-15T00:00:00Z",
          "sunset": "2026-07-01T23:59:59Z",
          "link": "https://forest-river-demo-main-fb06bf1.zuplo.site/api"
        }
      }
    },
    {
      "name": "v1-brownout-inbound",
      "policyType": "brownout-inbound",
      "handler": {
        "export": "BrownoutInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "cronSchedule": [
            "0 * * * *",
            "15 * * * *",
            "30 * * * *"
          ],
          "problem": {
            "type": "https://httpproblems.com/http-status/503",
            "title": "Scheduled Brownout \u2014 API v1 Retiring May 30, 2026",
            "detail": "Forest River API v1 is being retired on May 30, 2026. This brownout is a scheduled reminder to migrate to v2. See https://forest-river-demo-main-fb06bf1.zuplo.site/api for the migration guide.",
            "status": "503"
          }
        }
      }
    },
    {
      "name": "v1-sunset-inbound",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/v1-sunset)"
      }
    },
    {
      "name": "mcp-query-param-to-header-inbound",
      "policyType": "query-param-to-header-inbound",
      "handler": {
        "export": "QueryParamToHeaderInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "queryParam": "apiKey",
          "headerName": "Authorization",
          "headerValue": "Bearer {value}"
        }
      }
    }
  ],
  "corsPolicies": [
    {
      "name": "portal-cors",
      "allowedOrigins": [
        "https://forest-river-demo-main-fb06bf1.zuplo.site",
        "https://forest-river-demo-main-5ef061c.zuplo.site"
      ],
      "allowedMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allowedHeaders": [
        "Authorization",
        "Content-Type"
      ],
      "allowCredentials": true,
      "maxAge": 86400
    }
  ]
}