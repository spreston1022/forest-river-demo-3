{
  "openapi": "3.1.0",
  "info": {
    "title": "Forest River API",
    "version": "1.0.0",
    "description": "Forest River demo API gateway"
  },
  "paths": {
    "/openapi": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "OpenAPI Specification",
        "operationId": "get-openapi",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "openApiSpecHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "openApiFilePath": "./config/routes.oas.json"
            }
          },
          "policies": {
            "inbound": []
          }
        },
        "responses": {
          "200": {
            "description": "OpenAPI specification"
          }
        }
      }
    },
    "/subscriptions": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Submit subscription request",
        "operationId": "create-subscription",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "portal-cors",
          "handler": {
            "export": "createSubscription",
            "module": "$import(./modules/subscriptions)"
          },
          "policies": {
            "inbound": [
              "jwt-auth-inbound"
            ]
          }
        },
        "responses": {
          "201": {
            "description": "Subscription request created"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "get": {
        "summary": "Get my subscriptions",
        "operationId": "get-my-subscriptions",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "portal-cors",
          "handler": {
            "export": "getMySubscriptions",
            "module": "$import(./modules/subscriptions)"
          },
          "policies": {
            "inbound": [
              "jwt-auth-inbound"
            ]
          }
        },
        "responses": {
          "200": {
            "description": "List of consumer's subscriptions"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
