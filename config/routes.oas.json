{
  "openapi": "3.1.0",
  "info": {
    "title": "Forest River API",
    "version": "1.0.0",
    "description": "Forest River demo API gateway"
  },
  "paths": {
    "/path-1": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Echo endpoint",
        "description": "Forwards to echo.zuplo.io — requires a valid API key.",
        "operationId": "get-path-1",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://echo.zuplo.io"
            }
          },
          "policies": {
            "inbound": [
              "api-key-inbound",
              "plan-rate-limit-inbound"
            ]
          }
        },
        "responses": {
          "200": {
            "description": "Successful response from echo service"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/openapi": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "OpenAPI Specification",
        "operationId": "get-openapi",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "openApiSpecHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "openApiFilePath": "./config/routes.oas.json"
            }
          },
          "policies": {
            "inbound": []
          }
        },
        "responses": {
          "200": {
            "description": "OpenAPI specification"
          }
        },
        "description": ""
      }
    },
    "/subscriptions": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Submit subscription request",
        "operationId": "create-subscription",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "portal-cors",
          "handler": {
            "export": "createSubscription",
            "module": "$import(./modules/subscriptions)"
          },
          "policies": {
            "inbound": [
              "jwt-auth-inbound"
            ]
          }
        },
        "responses": {
          "201": {
            "description": "Subscription request created"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "get": {
        "summary": "Get my subscriptions",
        "operationId": "get-my-subscriptions",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "portal-cors",
          "handler": {
            "export": "getMySubscriptions",
            "module": "$import(./modules/subscriptions)"
          },
          "policies": {
            "inbound": [
              "jwt-auth-inbound"
            ]
          }
        },
        "responses": {
          "200": {
            "description": "List of consumer's subscriptions"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/admin/subscriptions": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "get": {
        "summary": "Admin — get all subscription requests",
        "operationId": "admin-get-subscriptions",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "portal-cors",
          "handler": {
            "export": "adminGetSubscriptions",
            "module": "$import(./modules/subscriptions)"
          },
          "policies": {
            "inbound": [
              "jwt-auth-inbound",
              "admin-auth-inbound"
            ]
          }
        },
        "responses": {
          "200": {
            "description": "All subscription requests"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/admin/subscriptions/{id}/approve": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Admin — approve subscription",
        "operationId": "admin-approve-subscription",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "portal-cors",
          "handler": {
            "export": "adminApproveSubscription",
            "module": "$import(./modules/subscriptions)"
          },
          "policies": {
            "inbound": [
              "jwt-auth-inbound",
              "admin-auth-inbound"
            ]
          }
        },
        "responses": {
          "200": {
            "description": "Subscription approved and key provisioned"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/admin/subscriptions/{id}/reject": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Admin — reject subscription",
        "operationId": "admin-reject-subscription",
        "x-internal": true,
        "x-zuplo-route": {
          "corsPolicy": "portal-cors",
          "handler": {
            "export": "adminRejectSubscription",
            "module": "$import(./modules/subscriptions)"
          },
          "policies": {
            "inbound": [
              "jwt-auth-inbound",
              "admin-auth-inbound"
            ]
          }
        },
        "responses": {
          "200": {
            "description": "Subscription rejected"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  }
}